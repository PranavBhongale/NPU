                </mxCell>
                <mxCell id="15" style="edgeStyle=none;shape=flexArrow;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fillColor=#4D0000;" parent="1" source="14" target="16" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="570.0869565217392" y="-840" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="14" value="without of this today the modern chip&amp;nbsp; cannot be possible but i take care of it&amp;nbsp; also&amp;nbsp;&amp;nbsp;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="510" y="-970" width="130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="" style="edgeStyle=none;shape=flexArrow;html=1;fillColor=#4D0000;" parent="1" source="16" target="18" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="&lt;b&gt;the solution is whenever we need matrix multiplication or NPU we have to run it at maximum throught put&amp;nbsp;&lt;/b&gt;&lt;div&gt;&lt;b&gt;when we dont need stop the clock of entire block&amp;nbsp;&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="492.5" y="-830" width="165" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="this will not work for big GPU and TPU but for our project it&#39;s ok&amp;nbsp;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="690" y="-805" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="" style="edgeStyle=none;shape=flexArrow;html=1;fillColor=#4D0000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" parent="1" source="21" target="22" edge="1">
