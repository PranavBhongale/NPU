                <mxCell id="5" value="I am not adding any power optimization it will&amp;nbsp; increase the compexicity of project a lot&amp;nbsp;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
