                </mxCell>
                <mxCell id="9" value="no clock gating&amp;nbsp; even i am adding valid ready protocall for each block&amp;nbsp;&amp;nbsp;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="-40" y="-830" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="for power gating there is procedure for it even for clock gating we need good asynchronous communcation&amp;nbsp; queue for data transfer and control synchronizer&amp;nbsp;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
