                <mxCell id="35" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;I tried to optimize hardware for common workload&amp;nbsp;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
