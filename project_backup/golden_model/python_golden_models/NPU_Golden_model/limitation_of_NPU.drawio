                </mxCell>
                <mxCell id="21" value="&lt;font style=&quot;font-size: 36px;&quot;&gt;I limit the sixe of matrix&amp;nbsp;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
