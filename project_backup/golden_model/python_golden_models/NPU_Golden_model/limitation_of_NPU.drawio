                </mxCell>
                <mxCell id="36" value="" style="edgeStyle=none;shape=flexArrow;html=1;fillColor=#4D0000;" parent="1" source="22" target="35" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;this is for hardware optimazation&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;if we have ulimited size the control logic of tiling become a more complicated&amp;nbsp; for scratch pad memory we dont gate benefit of data structure&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="700" y="-500" width="450" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="" style="edgeStyle=none;shape=flexArrow;html=1;fillColor=#4D0000;" parent="1" source="24" target="26" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;&lt;i&gt;the considerable size of jeneral workload of AI for inferencing is not grater then 8192&amp;nbsp; = 2^13&amp;nbsp; &amp;nbsp;so all the matrix should be less than 8192by8192&amp;nbsp; &amp;nbsp;this is a very big matrix&amp;nbsp; the general matrix we need to compute&amp;nbsp; for most of the time is always less than this&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" parent="1" vertex="1">
                    <mxGeometry x="950" y="-645" width="550" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="" style="edgeStyle=none;shape=flexArrow;html=1;fillColor=#4D0000;" parent="1" source="26" target="28" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;i&gt;what if we have to compute&amp;nbsp; matrix more than this size&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="1550" y="-645" width="305" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;the solution is :&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;software tiling&amp;nbsp; use NPU as tile this is also possible because of int32 bit output of NPU direct MAC OUTPUT without of quantization and activation&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#CCCCCC;" parent="1" vertex="1">
                    <mxGeometry x="1490" y="-420" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;WHY?&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=50;align=center;verticalAlign=middle;strokeWidth=1;autosize=1;spacing=4;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};fillColor=#CCCCCC;" parent="1" vertex="1">
